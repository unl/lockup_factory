{# templates/wdnbase.html.twig #}
{% extends '@WDNFramework/6.0/php.app_local.dwt.twig' %}

{% block head %}
<link rel="stylesheet" href="/css/custom.css?v={{ cache_version }}">
<script>
    window.UNL.idm.pushConfig('logoutRoute', '/logout/');
    {% if auth.isLoggedIn() %}
    window.UNL.idm.pushConfig('serverUser', '{{ auth.getUsername() }}');
    {% endif %}
</script>
{% endblock %}

{% block highlighted %}
{{ include('@DCFFramework/partials/flash-notices.html.twig') }}
{% endblock %}


